# Production Environment Configuration
PORT=5000
NODE_ENV=production

# MySQL Database Configuration (Production)
# Update these with your production database credentials
DB_HOST=your-production-db-host.amazonaws.com
DB_USER=prod_user
DB_PASSWORD=your_production_password
DB_NAME=sallah_sanjal_prod
DB_PORT=3306

# JWT Configuration (Production)
# IMPORTANT: Generate strong random secrets for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_generated_access_secret
JWT_REFRESH_SECRET=replace_with_generated_refresh_secret
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Server Configuration
API_URL=https://your-backend-url.com
FRONTEND_URL=https://your-frontend-url.vercel.app

# Socket.io Configuration
SOCKET_IO_CORS_ORIGIN=https://your-frontend-url.vercel.app

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,webp

# Rate Limiting
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_MAX=100
RATE_LIMIT_WINDOW_MS=900000
